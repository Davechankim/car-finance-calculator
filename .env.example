# 국가법령정보 공동활용에서 발급한 서버/관리자용 OC. 브라우저 변수로 만들지 않는다.
LAW_OPEN_API_OC=

# 공개 배포 주소. 사용자 소유 도메인 연결 후 해당 HTTPS 원본으로 변경한다.
NEXT_PUBLIC_SITE_URL=https://yechan-car-finance-2026.godwkd1030.chatgpt.site
NEXT_PUBLIC_SITE_PUBLIC=false

# 기본값은 완전 비활성이다. 공개·정책·CMP 검증을 마친 릴리스에서만 아래 게이트를 true로 바꾼다.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
# 실제 운영자·문의처·호스팅 로그·광고 파트너·동의 철회 문구를 확정한 뒤에만 true.
NEXT_PUBLIC_ADSENSE_POLICY_READY=false

# 고정 슬롯만 사용한다. AdSense 운영 계정에서도 Auto ads를 끈 것을 확인한 뒤 false를 유지한다.
NEXT_PUBLIC_ADSENSE_AUTO_ADS=false

# AdSense 승인 후 본인 계정에서 발급된 값을 입력한다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_CALCULATOR_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CALCULATOR_BOTTOM=
