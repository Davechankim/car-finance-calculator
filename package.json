{
  "name": "car-finance-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tax:mcp": "node --import tsx mcp/stdio.ts",
    "tax:mcp:smoke": "node --import tsx scripts/smoke-tax-mcp.ts",
    "tax:mcp:live-smoke": "node --import tsx scripts/smoke-tax-mcp.ts --live",
    "verify:adsense-release": "node --import tsx scripts/verify-adsense-release.ts",
    "verify:sites-build": "node scripts/verify-sites-build.mjs",
    "release:check": "npm test && npm run tax:mcp:smoke && npm run typecheck && npm run build && npm run verify:sites-build && npm run verify:adsense-release && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@mdx-js/rollup": "3.1.1",
    "@next/env": "^15.5.22",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vinext": "0.2.1",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "vite": "8.2.0"
  }
}
